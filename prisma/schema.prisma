generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cpus {
  masterId        Int             @id
  family          String          @db.VarChar(50)
  processorClass  String          @db.VarChar(50)
  socket          String          @db.VarChar(50)
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([family])
  @@index([socket])
}

model favorite_products {
  customerId    Int
  shopProductId Int
  add_date  DateTime        @default(now())

  user         User         @relation(fields: [customerId], references: [userId])
  shop_products shop_products @relation(fields: [shopProductId], references: [shopProductId])
  @@id([customerId, shopProductId])
}

model favorite_shops {
  customerId Int
  shopId     Int
  add_date  DateTime        @default(now())

  user      User @relation(fields: [customerId], references: [userId])
  shops     shops @relation(fields: [shopId], references: [shopId])
  @@id([customerId, shopId])
}

model mainboards {
  masterId        Int             @id
  formFactor      String          @db.VarChar(50)
  socket          String          @db.VarChar(50)
  chipset         String          @db.VarChar(50)
  
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([formFactor])
  @@index([socket])
}

model master_hardware {
  masterId      Int             @id @default(autoincrement())
  hardwareKey   String          @unique
  displayName   String
  brand         String
  category      Category
  searchCount   Int             @default(0)
  specs         Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  cpus          cpus?
  mainboards    mainboards?
  psus          psus?
  rams          rams?
  shop_products shop_products[]
  storages      storages?
  vgas          vgas?

  @@index([category, brand])
}

model psus {
  masterId        Int             @id
  watt            Int
  standard80Plus  String          @db.VarChar(100)
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([watt])
}

model rams {
  masterId        Int             @id
  ramType         String          @db.VarChar(50)
  capacityGB      Int
  busSpeed        Int
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([capacityGB, busSpeed])
  @@index([ramType])
}

model shop_products {
  shopProductId     Int                 @id @default(autoincrement())
  shopId            Int
  masterId          Int
  customTitle       String?             @db.VarChar(255)
  price             Decimal
  warranty          String?             @db.VarChar(20)
  description       String?
  imageUrl          String?
  updatedAt         DateTime
  createdAt         DateTime            @default(now())
  favorite_products favorite_products[]
  master_hardware   master_hardware     @relation(fields: [masterId], references: [masterId])
  shops             shops               @relation(fields: [shopId], references: [shopId])

  @@index([masterId])
  @@index([shopId])
}

model shops {
  shopId          Int              @id @default(autoincrement())
  userId          Int              @unique
  ownerFirstName  String           @db.VarChar(50)
  ownerLastName   String           @db.VarChar(50)
  profileImageUrl String?
  shopName        String           @db.VarChar(100)
  shopDescription String?
  addressText     String?
  subDistrict     String?          @db.VarChar(50)
  district        String?          @db.VarChar(50)
  province        String?          @db.VarChar(50)
  zipCode         String?          @db.VarChar(10)
  contactChannels Json?
  ownerPhone      String?          @db.VarChar(13)
  operatingHours  String?          @db.VarChar(100)
  latitude        Decimal?
  longitude       Decimal?
  shopStatus      ShopStatus
  submittedAt     DateTime         @default(now())
  idCardImage     String?
  businessRegImage    String? 
  storeImnage    String?
  approveAt      DateTime?

  favorite_shops  favorite_shops[]
  shop_products   shop_products[]
  user           User            @relation(fields: [userId], references: [userId])
}

model storages {
  masterId        Int             @id
  storageType     String          @db.VarChar(50)
  interfaceType   String          @db.VarChar(50)
  capacityGB      Int
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([capacityGB])
}

model User {
  userId            Int                 @id @default(autoincrement())
  email             String              @unique @db.VarChar(100)
  displayName       String              @db.VarChar(50)
  userRole          UserRole
  userStatus        UserStatus
  refreshToken      String? @unique
  profilePicture    String?
  favorite_products favorite_products[]
  favorite_shops    favorite_shops[]
  shops             shops?

  @@map("users")
}

model vgas {
  masterId        Int             @id
  series          String          @db.VarChar(50)
  chipset         String?
  vramSize        Int?
  master_hardware master_hardware @relation(fields: [masterId], references: [masterId], onDelete: Cascade)

  @@index([series])
}

enum Category {
  CPU
  MAINBOARD
  VGA
  RAM
  STORAGE
  PSU
  CASE
  COOLER
}

enum ShopStatus {
  PENDING
  OPEN
  CLOSED
  REJECTED
  SUSPENDED
}

enum UserRole {
  CUSTOMER
  shop
  admin
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
